###############################################################################
#  .env  –  Environment variables for the central monitoring stack.
#  DO NOT commit this file to version control.
#  Add .env to your .gitignore.
###############################################################################

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeToSomethingStrong!

# ── Traefik ACME ─────────────────────────────────────────────────────────
ACME_EMAIL=admin@mycompany.com

# ── MS Teams Webhooks ────────────────────────────────────────────────────
TEAMS_WEBHOOK_CRITICAL=https://mycompany.webhook.office.com/webhookb2/REPLACE_ME
TEAMS_WEBHOOK_WARNINGS=https://mycompany.webhook.office.com/webhookb2/REPLACE_ME
TEAMS_WEBHOOK_DEV=https://mycompany.webhook.office.com/webhookb2/REPLACE_ME
